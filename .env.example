# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# Supabase project settings (Settings -> API in the Supabase dashboard).
# The anon key is safe to ship in the client; it only grants what RLS allows.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# RevenueCat public SDK key for iOS (RevenueCat dashboard -> API keys).
# Optional: without it, Finzy Pro purchases are disabled but the rest of the
# app (all core learning features) works normally.
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=

# Server-only secrets (Supabase Edge Function secrets, EAS secrets) —
# NEVER prefix these with EXPO_PUBLIC_ and never put them in this file's
# committed counterpart:
#   SUPABASE_SERVICE_ROLE_KEY
#   REVENUECAT_WEBHOOK_SECRET
